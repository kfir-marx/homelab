[Unit]
Description=Refresh Proxmox Windows template from its linked workstation clone
Documentation=file:///usr/local/sbin/refresh-windows-template
After=pve-cluster.service pvedaemon.service
Wants=pve-cluster.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/refresh-windows-template
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=infinity

