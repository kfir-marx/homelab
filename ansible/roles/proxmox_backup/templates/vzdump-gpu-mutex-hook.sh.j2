#!/usr/bin/env bash
set -Eeuo pipefail

readonly SOURCE_VMID={{ proxmox_backup_gpu_mutex_source_vmid | int }}
readonly SHUTDOWN_TIMEOUT={{ proxmox_backup_gpu_mutex_shutdown_timeout_seconds | int }}
readonly CONFLICTING_VMIDS=({% for vmid in proxmox_backup_gpu_mutex_conflicting_vmids %}{{ vmid | int }} {% endfor %})
readonly STATE_DIR="/run/vzdump-gpu-mutex-${SOURCE_VMID}"

phase="${1:-}"

log() {
  printf '%s vzdump-gpu-mutex: %s\n' "$(date --iso-8601=seconds)" "$*"
}

vm_exists() {
  qm status "$1" >/dev/null 2>&1
}

vm_status() {
  qm status "$1" | awk '{print $2}'
}

restart_released_vms() {
  local marker vmid
  [[ -d "${STATE_DIR}" ]] || return 0

  for marker in "${STATE_DIR}"/restart-*; do
    [[ -f "${marker}" ]] || continue
    vmid="${marker##*-}"
    if vm_exists "${vmid}" && [[ "$(vm_status "${vmid}")" == stopped ]]; then
      log "restarting VM ${vmid} after VM ${SOURCE_VMID} backup"
      qm start "${vmid}"
    fi
    rm -f -- "${marker}"
  done
  rmdir -- "${STATE_DIR}" 2>/dev/null || true
}

case "${phase}" in
  job-init)
    if [[ -d "${STATE_DIR}" ]]; then
      log "stale state directory ${STATE_DIR} requires manual review"
      exit 1
    fi
    ;;
  job-start)
    vm_exists "${SOURCE_VMID}" || {
      log "source VM ${SOURCE_VMID} does not exist"
      exit 1
    }

    if [[ "$(vm_status "${SOURCE_VMID}")" == running ]]; then
      for vmid in "${CONFLICTING_VMIDS[@]}"; do
        if vm_exists "${vmid}" && [[ "$(vm_status "${vmid}")" == running ]]; then
          log "invariant violation: VMs ${SOURCE_VMID} and ${vmid} are both running"
          exit 1
        fi
      done
      exit 0
    fi

    for vmid in "${CONFLICTING_VMIDS[@]}"; do
      if vm_exists "${vmid}" && [[ "$(vm_status "${vmid}")" == running ]]; then
        mkdir -p -- "${STATE_DIR}"
        : >"${STATE_DIR}/restart-${vmid}"
        log "gracefully stopping conflicting VM ${vmid} for stopped VM ${SOURCE_VMID} backup"
        qm shutdown "${vmid}" --timeout "${SHUTDOWN_TIMEOUT}"
        [[ "$(vm_status "${vmid}")" == stopped ]] || {
          log "VM ${vmid} did not stop cleanly"
          exit 1
        }
      fi
    done
    ;;
  job-end|job-abort)
    restart_released_vms
    ;;
  backup-start|backup-end|backup-abort|log-end|pre-stop|pre-restart|post-restart)
    ;;
  *)
    log "unknown hook phase: ${phase:-missing}"
    exit 1
    ;;
esac
