{
  "manifest_version": 3,
  "name": "FlightStay Match",
  "version": "0.1.0",
  "description": "Find hotel confirmation emails that match your configured flights.",
  "minimum_chrome_version": "105",
  "permissions": ["identity", "storage"],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://staymatch.547600.xyz/*"
  ],
  "oauth2": {
    "client_id": "REPLACE_WITH_CHROME_EXTENSION_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.readonly"]
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-128.png",
    "32": "icons/icon-128.png",
    "48": "icons/icon-128.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open FlightStay Match",
    "default_icon": "icons/icon-128.png"
  }
}
