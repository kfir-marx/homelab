# Terraform
*.tfstate
*.tfstate.*
*.tfplan
tfplan
.terraform/
.terraform.lock.hcl
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terragrunt
.terragrunt-cache/
.terragrunt.generated/

# Secrets — never commit these
.env
.env.*
!.env-template
*.pem
*.key
talosconfig
talosconfig.yaml
kubeconfig
kubeconfig.yaml

# SOPS working files. The encrypted age identity (*.age), SOPS dotenv, and
# *.sops.json Kubernetes snapshots under secrets/ are intentionally tracked.
secrets/**/*.dec
secrets/**/*.decrypted
secrets/age/*
!secrets/age/.gitkeep
!secrets/age/*.agekey.age
secrets/kubernetes/*
!secrets/kubernetes/.gitkeep
!secrets/kubernetes/*.sops.json
secrets/*.env
!secrets/*.sops.env

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
.venv*/
__pycache__/
*.py[cod]
*.swp
*.swo


# JavaScript dependencies and build output
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

